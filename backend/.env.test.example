SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=your-local-anon-key
SUPABASE_SECRET_KEY=your-local-service-role-key

# All three print from `supabase start` (API_URL, PUBLISHABLE_KEY,
# SECRET_KEY). These are the same fixed local-dev defaults for every
# Supabase CLI project, not secrets — safe to keep in .env.test.
#
# SUPABASE_SECRET_KEY is ONLY ever used here, to delete test users via
# the admin API after a test run. It must never be used against the
# real project or outside test cleanup — see backend/src/db/testCleanup.ts.
